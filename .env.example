# Application Metadata
APP_NAME=Bank Transaction Anomaly Pipeline
APP_VERSION=1.0.0
APP_ENV=development
LOG_LEVEL=INFO

# Reproducibility & Anomaly Thresholds
RANDOM_SEED=42
N_CLUSTERS=2
ANOMALY_QUANTILE=0.92
ZSCORE_THRESHOLD=2.5

# Resilience & Network Safeguards
REQUEST_TIMEOUT_SECONDS=10.0
MAX_BATCH_SIZE=5000
RATE_LIMIT_PER_MINUTE=120
CACHE_TTL_SECONDS=300

# Model Artifacts & CORS
MODEL_DIR=models
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:8000
